# Número de WhatsApp del vendedor en formato internacional, SIN "+" ni espacios.
# Ej: Argentina 549111... | México 521... | España 34...
NEXT_PUBLIC_WHATSAPP_NUMBER=5491112345678

# Nombre de la marca (aparece en el header, títulos y mensajes de WhatsApp)
NEXT_PUBLIC_STORE_NAME=Titan Supplements

# Los precios existentes se guardan en dólares (USD) y se muestran en C$ por defecto.
# Córdobas por US$1; se aplica a productos, carrito, facturas y WhatsApp.
NEXT_PUBLIC_USD_EXCHANGE_RATE=36.6243

# Contraseña del panel de administración (/admin)
ADMIN_PASSWORD=admin123

# URL pública canónica del sitio (con https://, sin barra final). Se usa para
# los links absolutos del recibo (WhatsApp/QR) y los metadatos. Ej: https://tutienda.com
NEXT_PUBLIC_SITE_URL=

# --- Base de datos (Supabase) ---
# En Supabase: Project Settings → API.
#   SUPABASE_URL                -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY   -> "Project API keys" → service_role (SECRETA)
# IMPORTANTE: la service role key es secreta y sólo se usa del lado del
# servidor. Nunca la pongas en variables NEXT_PUBLIC_ ni la expongas al cliente.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
